<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Proposal" targetNamespace="https://demo.ac.id/proposal">
  <bpmn:process id="proposal_skripsi" name="Pengajuan Proposal Skripsi" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:documentation>Adaptasi sederhana studi Bahaweres dkk. (2012). Satu dosen sekaligus calon pembimbing; revisi kembali ke verifikasi. Notifikasi hanya simulasi lokal.</bpmn:documentation>
    <bpmn:startEvent id="mulai" name="Proposal diajukan"/>
    <bpmn:userTask id="verifikasi" name="Verifikasi sekretaris prodi" camunda:candidateGroups="sekprodi"/>
    <bpmn:exclusiveGateway id="cek_verifikasi" name="Hasil verifikasi?" default="f_v_tolak"/>
    <bpmn:userTask id="review" name="Penilaian dosen" camunda:candidateGroups="dosen"/>
    <bpmn:exclusiveGateway id="cek_review" name="Hasil penilaian?" default="f_d_tolak"/>
    <bpmn:userTask id="persetujuan" name="Persetujuan ketua prodi" camunda:candidateGroups="kaprodi"/>
    <bpmn:exclusiveGateway id="cek_persetujuan" name="Disetujui?" default="f_k_tolak"/>
    <bpmn:userTask id="revisi" name="Revisi mahasiswa" camunda:assignee="${nim}"/>
    <bpmn:serviceTask id="terbitkan" name="Buat draf dan notifikasi" camunda:delegateExpression="${outcomeDelegate}"/>
    <bpmn:serviceTask id="tolak" name="Catat penolakan dan notifikasi" camunda:delegateExpression="${outcomeDelegate}"/>
    <bpmn:endEvent id="selesai_setuju" name="Disetujui"/>
    <bpmn:endEvent id="selesai_tolak" name="Ditolak"/>
    <bpmn:sequenceFlow id="f_mulai" sourceRef="mulai" targetRef="verifikasi"/>
    <bpmn:sequenceFlow id="f_verifikasi" sourceRef="verifikasi" targetRef="cek_verifikasi"/>
    <bpmn:sequenceFlow id="f_v_setuju" name="Layak" sourceRef="cek_verifikasi" targetRef="review"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${keputusan == 'SETUJU'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_v_revisi" name="Revisi" sourceRef="cek_verifikasi" targetRef="revisi"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${keputusan == 'REVISI'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_v_tolak" name="Tolak" sourceRef="cek_verifikasi" targetRef="tolak"/>
    <bpmn:sequenceFlow id="f_review" sourceRef="review" targetRef="cek_review"/>
    <bpmn:sequenceFlow id="f_d_setuju" name="Layak dan bersedia" sourceRef="cek_review" targetRef="persetujuan"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${keputusan == 'SETUJU'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_d_revisi" name="Revisi" sourceRef="cek_review" targetRef="revisi"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${keputusan == 'REVISI'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_d_tolak" name="Tolak" sourceRef="cek_review" targetRef="tolak"/>
    <bpmn:sequenceFlow id="f_persetujuan" sourceRef="persetujuan" targetRef="cek_persetujuan"/>
    <bpmn:sequenceFlow id="f_k_setuju" name="Ya" sourceRef="cek_persetujuan" targetRef="terbitkan"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${keputusan == 'SETUJU'}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_k_tolak" name="Tidak" sourceRef="cek_persetujuan" targetRef="tolak"/>
    <bpmn:sequenceFlow id="f_ulang" name="Kirim ulang" sourceRef="revisi" targetRef="verifikasi"/>
    <bpmn:sequenceFlow id="f_terbit" sourceRef="terbitkan" targetRef="selesai_setuju"/>
    <bpmn:sequenceFlow id="f_tolak" sourceRef="tolak" targetRef="selesai_tolak"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Proposal"><bpmndi:BPMNPlane id="Plane_Proposal" bpmnElement="proposal_skripsi">
    <bpmndi:BPMNShape id="mulai_di" bpmnElement="mulai"><dc:Bounds x="40" y="182" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="20" y="228" width="80" height="40"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="verifikasi_di" bpmnElement="verifikasi"><dc:Bounds x="125" y="160" width="125" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="cek_verifikasi_di" bpmnElement="cek_verifikasi" isMarkerVisible="true"><dc:Bounds x="300" y="175" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="285" y="235" width="85" height="35"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="review_di" bpmnElement="review"><dc:Bounds x="415" y="160" width="125" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="cek_review_di" bpmnElement="cek_review" isMarkerVisible="true"><dc:Bounds x="590" y="175" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="575" y="235" width="85" height="35"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="persetujuan_di" bpmnElement="persetujuan"><dc:Bounds x="735" y="160" width="125" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="cek_persetujuan_di" bpmnElement="cek_persetujuan" isMarkerVisible="true"><dc:Bounds x="910" y="175" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="900" y="140" width="80" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="revisi_di" bpmnElement="revisi"><dc:Bounds x="410" y="30" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="terbitkan_di" bpmnElement="terbitkan"><dc:Bounds x="1020" y="160" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="tolak_di" bpmnElement="tolak"><dc:Bounds x="735" y="330" width="130" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="selesai_setuju_di" bpmnElement="selesai_setuju"><dc:Bounds x="1200" y="182" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1180" y="228" width="80" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="selesai_tolak_di" bpmnElement="selesai_tolak"><dc:Bounds x="925" y="352" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="906" y="400" width="80" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="f_mulai_di" bpmnElement="f_mulai"><di:waypoint x="76" y="200"/><di:waypoint x="125" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_verifikasi_di" bpmnElement="f_verifikasi"><di:waypoint x="250" y="200"/><di:waypoint x="300" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_v_setuju_di" bpmnElement="f_v_setuju"><di:waypoint x="350" y="200"/><di:waypoint x="415" y="200"/><bpmndi:BPMNLabel><dc:Bounds x="365" y="180" width="45" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_v_revisi_di" bpmnElement="f_v_revisi"><di:waypoint x="325" y="175"/><di:waypoint x="325" y="70"/><di:waypoint x="410" y="70"/><bpmndi:BPMNLabel><dc:Bounds x="330" y="108" width="50" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_v_tolak_di" bpmnElement="f_v_tolak"><di:waypoint x="325" y="225"/><di:waypoint x="325" y="390"/><di:waypoint x="735" y="390"/><bpmndi:BPMNLabel><dc:Bounds x="345" y="370" width="45" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_review_di" bpmnElement="f_review"><di:waypoint x="540" y="200"/><di:waypoint x="590" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_d_setuju_di" bpmnElement="f_d_setuju"><di:waypoint x="640" y="200"/><di:waypoint x="735" y="200"/><bpmndi:BPMNLabel><dc:Bounds x="646" y="163" width="84" height="35"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_d_revisi_di" bpmnElement="f_d_revisi"><di:waypoint x="615" y="175"/><di:waypoint x="615" y="70"/><di:waypoint x="540" y="70"/><bpmndi:BPMNLabel><dc:Bounds x="620" y="105" width="45" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_d_tolak_di" bpmnElement="f_d_tolak"><di:waypoint x="615" y="225"/><di:waypoint x="615" y="350"/><di:waypoint x="735" y="350"/><bpmndi:BPMNLabel><dc:Bounds x="625" y="318" width="45" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_persetujuan_di" bpmnElement="f_persetujuan"><di:waypoint x="860" y="200"/><di:waypoint x="910" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_k_setuju_di" bpmnElement="f_k_setuju"><di:waypoint x="960" y="200"/><di:waypoint x="1020" y="200"/><bpmndi:BPMNLabel><dc:Bounds x="980" y="180" width="30" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_k_tolak_di" bpmnElement="f_k_tolak"><di:waypoint x="935" y="225"/><di:waypoint x="935" y="290"/><di:waypoint x="800" y="290"/><di:waypoint x="800" y="330"/><bpmndi:BPMNLabel><dc:Bounds x="870" y="268" width="45" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_ulang_di" bpmnElement="f_ulang"><di:waypoint x="475" y="30"/><di:waypoint x="475" y="0"/><di:waypoint x="188" y="0"/><di:waypoint x="188" y="160"/><bpmndi:BPMNLabel><dc:Bounds x="205" y="5" width="80" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_terbit_di" bpmnElement="f_terbit"><di:waypoint x="1150" y="200"/><di:waypoint x="1200" y="200"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="f_tolak_di" bpmnElement="f_tolak"><di:waypoint x="865" y="370"/><di:waypoint x="925" y="370"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
